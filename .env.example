# ─────────────────────────────────────────────────────────────────────────────
# SoleScout FDS — Environment Variables
# Copy this file to .env and fill in your actual values.
# ⚠️  NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# SoleScout External API credentials
SOLESCOUT_API_KEY=your_api_key_here
SOLESCOUT_BASE_URL=https://solescout.ai

# App settings
APP_ENV=development
LOG_LEVEL=INFO
